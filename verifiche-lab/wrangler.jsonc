{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "verifichelab",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "verifichelab"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "verifichelab",
      // Incolla qui l'id stampato da: npx wrangler d1 create verifichelab
      "database_id": "INSERISCI-QUI-L-ID-DEL-DATABASE",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Impostazioni dell'app (senza segreti). Il generatore resta quello locale, senza AI esterna.
  "vars": {
    "AI_PROVIDER": "offline",
    "AI_MODEL": "demo-deterministico",
    "INSTITUTE_NAME": "Istituto di Istruzione Superiore"
  }
}
