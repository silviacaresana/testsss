{
  "name": "verifiche-lab",
  "version": "0.2.0",
  "private": true,
  "description": "VerificheLab — generatore di verifiche di Matematica e Fisica (versione semplice, su Cloudflare)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "embed": "node scripts/embed-assets.mjs",
    "postinstall": "prisma generate",
    "predev": "npm run embed",
    "dev": "next dev -p 3000",
    "prebuild": "npm run embed",
    "build": "next build",
    "lint": "next lint",
    "pretypecheck": "npm run embed",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run embed",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:sql": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script --output migrations/0001_init.sql",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.0.0",
    "@prisma/adapter-d1": "^6.16.0",
    "@prisma/client": "^6.16.0",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.0",
    "eta": "^3.5.0",
    "postcss": "^8.5.0",
    "prisma": "^6.16.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
