# --- Database -------------------------------------------------------------
# SQLite locale (default, nessuna installazione richiesta).
DATABASE_URL="file:./dev.db"
# Per PostgreSQL 16 (Docker Compose): cambia il provider in prisma/schema.prisma
# e usa: DATABASE_URL="postgresql://verifiche:verifiche@localhost:5432/verifiche?schema=public"

# --- Applicazione ---------------------------------------------------------
APP_URL="http://localhost:3000"
AUTH_SECRET="cambia-questo-segreto-in-produzione-almeno-32-caratteri"
SESSION_DAYS=30

# --- AI -------------------------------------------------------------------
# openai | anthropic | google | ollama | custom | offline
# "offline" = generatore deterministico locale, utile per demo e scuole senza rete.
AI_PROVIDER=offline
AI_MODEL=demo-deterministico
AI_MODEL_CRITIC=
AI_API_KEY=
AI_BASE_URL=
AI_MAX_COST_PER_GENERATION=0.30
AI_TIMEOUT_MS=90000
AI_RATE_LIMIT_PER_HOUR=20
AI_MONTHLY_BUDGET_EUR=30

# --- LaTeX ----------------------------------------------------------------
LATEX_ENGINE=tectonic
LATEX_BIN=
LATEX_TIMEOUT_MS=60000
LATEX_DEFAULT_FONT=

# --- Istituto -------------------------------------------------------------
INSTITUTE_NAME="Istituto di Istruzione Superiore"
INSTITUTE_LOGO_PATH=
