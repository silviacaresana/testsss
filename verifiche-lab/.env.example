# VerificheLab su Cloudflare: la configurazione sta in wrangler.jsonc (sezione "vars").
# Questo file serve solo se vuoi cambiare un'impostazione in locale con `npm run dev`.
#
# Generatore: "offline" = generatore deterministico locale, nessuna chiamata esterna.
# Se attivi un provider AI (openai | anthropic | google | custom), la chiave NON va mai messa in
# wrangler.jsonc né su Git: impostala come segreto con `npx wrangler secret put AI_API_KEY`.
AI_PROVIDER=offline
AI_MODEL=demo-deterministico
INSTITUTE_NAME="Istituto di Istruzione Superiore"
