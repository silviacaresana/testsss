        "type": "short_answer",
        "prompt": "Un articolo costa 190 euro. Viene applicato uno sconto del 50%. Calcola lo sconto e il prezzo finale. Scrivi il risultato e una breve giustificazione. Giustifica il procedimento seguito.",
        "options": [],
        "correctOption": null,
        "points": 6.75,
        "difficulty": 2,
        "estimatedMin": 4,
        "topicId": "cmvpg6jk80007u0r4rfr2d8tj",
        "objectives": [
          "CLA1.PERC.1"
        ],
        "solutionSteps": [
          "Sconto: $190 \\cdot \\dfrac{50}{100} = 95$ euro.",
          "Prezzo finale: $190 - 95 = 95$ euro.",
          "Verifica: il prezzo finale è il 50% di quello iniziale."
        ],
        "gradingCriteria": [
