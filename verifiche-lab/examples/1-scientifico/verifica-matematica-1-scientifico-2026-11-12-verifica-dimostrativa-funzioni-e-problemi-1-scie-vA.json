        "prompt": "Determina la soluzione dell'equazione $3x + 2 = 20$, motivando i passaggi. Scrivi il risultato e una breve giustificazione.",
        "options": [],
        "correctOption": null,
        "points": 6.5,
        "difficulty": 4,
        "estimatedMin": 6,
        "topicId": "cmvpg6jl00012u0r4mv7t94c2",
        "objectives": [
          "SCI1.EQ.2"
        ],
        "solutionSteps": [
          "Isola il termine con l'incognita: $3x = 20 - 2 = 18$.",
          "Dividi entrambi i membri per $3$: $x = \\dfrac{18}{3} = 6$.",
          "Verifica: $3\\cdot 6 + 2 = 20$, quindi la soluzione è corretta."
        ],
