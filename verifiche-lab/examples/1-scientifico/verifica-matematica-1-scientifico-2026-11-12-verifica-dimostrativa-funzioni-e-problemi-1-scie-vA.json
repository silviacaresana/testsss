        "estimatedMin": 5,
        "topicId": "cmvpg6jl0000zu0r439jww3tw",
        "objectives": [
          "SCI1.POL.1"
        ],
        "solutionSteps": [
          "Cerchiamo due numeri con somma $-2$ e prodotto $-3$.",
          "I numeri sono $1$ e $-3$.",
          "Quindi $x^2 + 2x - 3 = $(x - 1)(x + 3)$$."
        ],
        "gradingCriteria": [
